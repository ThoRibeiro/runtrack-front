{
  "name": "runtrack-front",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.2",
  "volta": {
    "node": "22.21.1",
    "pnpm": "10.29.2"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "verify": "turbo run lint typecheck test",
    "web": "pnpm --filter @runtrack/web start",
    "mobile": "pnpm --filter @runtrack/mobile start",
    "format": "prettier --write .",
    "budget": "node scripts/check-web-budget.mjs --export",
    "lcp": "node perf/measure-lcp.mjs",
    "e2e": "pnpm --filter @runtrack/web e2e",
    "logo": "node scripts/build-logo-assets.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "turbo": "^2.10.12",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "//": "Expo SDK 57 pins Reanimated 4.5.1, which asserts the Worklets version at import. Left to resolve on its own, pnpm hoists 0.12.1 and every test fails on a version assertion rather than on anything real.",
    "overrides": {
      "react-native-worklets": "0.10.1"
    }
  },
  "dependencies": {
    "expo": "~57.0.18",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
